{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": [
    "features/**/*.ts",
    "step-definitions/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
